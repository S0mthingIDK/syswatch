#!/usr/bin/env python3
"""Launcher that runs syswatch straight from a checkout.

Prefers the project's .venv interpreter when present (it carries the TUI
dependencies at pinned versions); otherwise falls back to whichever Python
started this script.
"""

import os
import sys

_HERE = os.path.dirname(os.path.realpath(__file__))
_ROOT = os.path.dirname(_HERE)
_VENV_ROOT = os.path.join(_ROOT, ".venv")
_SCRIPT = os.path.realpath(__file__)

# A venv is identified by sys.prefix, not by the interpreter path: venv
# pythons are typically symlinks to the very same system binary.
_running_in_our_venv = os.path.exists(_VENV_ROOT) and os.path.realpath(
    sys.prefix
) == os.path.realpath(_VENV_ROOT)

if not _running_in_our_venv and os.path.isfile(os.path.join(_VENV_ROOT, "bin", "python")):
    venv_python = os.path.join(_VENV_ROOT, "bin", "python")
    os.execv(venv_python, [venv_python, _SCRIPT, *sys.argv[1:]])

sys.path.insert(0, _ROOT)

from syswatch.cli import main

if __name__ == "__main__":
    raise SystemExit(main())
